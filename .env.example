# 開発環境用の環境変数雛形。
# 実体は .env に複製して使用する（.gitignore で追跡対象外）。
# 本番環境（NAS）では Docker Compose の secrets 機構で別途供給するため
# .env は使わない。

# ── DB 接続 ──
# パスワードは PG_PASSWORD_FILE 経由で渡すことを原則とするため、
# URL にはユーザ名のみ書き、パスワードは PG_PASSWORD_FILE から注入する。
# ローカル開発の利便性のためにパスワードを URL に含める運用も可。
DATABASE_URL=postgresql://kakeibo:devpassword@localhost:5432/kakeibo

# ── Docker secret ファイルパス（FILE 規約） ──
# 開発時は secrets/<name>.txt を直接参照する。
# 本番では /run/secrets/<name> に Docker 側でマウントされる。
PG_PASSWORD_FILE=./secrets/pg_password.txt
ANTHROPIC_API_KEY_FILE=./secrets/anthropic_key.txt
PAYPAL_API_SECRET_FILE=./secrets/paypal_api_secret.txt
GMAIL_OAUTH_TOKEN_FILE=./secrets/gmail_oauth_token.json

# ── API サーバ起動パラメータ ──
# `python -m kakeibo.api`（src/kakeibo/api/__main__.py）が参照する。
# host バインドは compose.override.yml で 127.0.0.1 に絞るため、
# コンテナ内では 0.0.0.0 を維持する。
API_HOST=0.0.0.0
API_PORT=8000
# 1 で Flask debug モード（リロード無効）。本番（compose.yml）は未設定で 0 扱い。
FLASK_DEBUG=0

# ── ロギング ──
# structlog のレベル。compose.override.yml は dev 用に DEBUG を上書きする。
LOG_LEVEL=INFO

# ── ワーカ heartbeat ──
# `kakeibo.worker.run()` が周期 touch するファイルパス。
# Docker HEALTHCHECK が mtime の鮮度で生存判定する（compose.yml worker 参照）。
WORKER_HEARTBEAT_PATH=/tmp/worker_heartbeat

# ── 取込ディレクトリ ──
INBOX_PATH=./inbox
ARCHIVE_PATH=./archive
DEAD_LETTER_PATH=./dead_letter

# ── タイムゾーン（コンテナ内で参照） ──
TZ=Asia/Tokyo
